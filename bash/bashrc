# Loaded by ~/.bashrc

export EDITOR=nvim VISUAL=nvim

HISTSIZE=100000
HISTFILESIZE=100000

# mise
if [ -x "$HOME/.local/bin/mise" ]; then
    eval "$("$HOME/.local/bin/mise" activate bash)"
fi

# Debian renames
command -v fdfind >/dev/null && alias fd=fdfind
command -v batcat >/dev/null && alias bat=batcat

# Energy profiles
if command -v powerprofilesctl >/dev/null; then
    alias perf='powerprofilesctl set performance'
    alias bal='powerprofilesctl set balanced'
    alias eco='powerprofilesctl set power-saver'
fi

# fzf: Ctrl+R (history), Ctrl+T (files), Alt+C (directories)
if command -v fzf >/dev/null; then
    if [ -f /usr/share/doc/fzf/examples/key-bindings.bash ]; then
        . /usr/share/doc/fzf/examples/key-bindings.bash
    else
        eval "$(fzf --bash)"
    fi
fi

if command -v fdfind >/dev/null; then _fd=fdfind; else _fd=fd; fi
export FZF_DEFAULT_COMMAND="$_fd --type f --hidden --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="$_fd --type d --hidden --exclude .git"

_repo="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"

# starship
export STARSHIP_CONFIG="$_repo/starship/starship.toml"
command -v starship >/dev/null && eval "$(starship init bash)"

# claude sandbox
export PATH="$_repo/bin:$PATH"

# opencode
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# zoxide
command -v zoxide >/dev/null && eval "$(zoxide init bash)"
