#!/bin/bash
# Set up this dev environment on a fresh Debian 13 (trixie) install.
#
# Common steps run on every machine; hardware choices come from
# hosts/<hostname>.sh. Safe to re-run: every step checks before changing
# anything, and existing configs are moved aside, never deleted.
#
# Usage: devenv-setup [hostname]   (defaults to this machine's hostname)
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
host="${1:-$(hostname)}"
profile="$repo/hosts/$host.sh"

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }
note() { printf '    %s\n' "$1"; }
has() { command -v "$1" >/dev/null 2>&1; }
apt_install() { sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"; }
todo=()
later() { todo+=("$1"); }

# Write a root-owned file only if its content changed. Returns 0 if written.
write_root() {
    local file="$1" content
    content="$(cat)"
    if [ -f "$file" ] && [ "$(sudo cat "$file")" = "$content" ]; then
        return 1
    fi
    printf '%s\n' "$content" | sudo tee "$file" >/dev/null
}

# Symlink $2 -> $1, moving anything else at $2 aside first.
link() {
    local src="$1" dst="$2"
    [ -e "$src" ] || return 0
    if [ -L "$dst" ] && [ "$(readlink -f "$dst")" = "$(readlink -f "$src")" ]; then
        return 0
    fi
    mkdir -p "$(dirname "$dst")"
    if [ -e "$dst" ] || [ -L "$dst" ]; then
        local bak="$dst.bak-$(date +%Y%m%d%H%M%S)"
        mv "$dst" "$bak"
        note "moved aside: $bak"
    fi
    ln -s "$src" "$dst"
    note "linked: $dst"
}

# ---------------------------------------------------------------------------
# Checks
# ---------------------------------------------------------------------------

[ "$(id -u)" -ne 0 ] || { echo "Run as your user, not root."; exit 1; }
if ! has sudo || ! id -nG | grep -qw sudo; then
    echo "Your user needs sudo. As root (installed with a root password):"
    echo "  su - -c \"apt install -y sudo git && usermod -aG sudo $USER\""
    echo "Then log out and back in, and run devenv-setup again."
    exit 1
fi
. /etc/os-release
[ "${VERSION_CODENAME:-}" = trixie ] || { echo "Expected Debian 13 (trixie), found ${PRETTY_NAME:-unknown}."; exit 1; }
if [ ! -f "$profile" ]; then
    echo "No profile for '$host'. Available:"
    ls "$repo/hosts" | sed 's/\.sh$//; s/^/  /'
    echo "Set the hostname (sudo hostnamectl set-hostname <name>) or pass it: devenv-setup <name>"
    exit 1
fi
. "$profile"

echo "Setting up '$host': kernel=$KERNEL gpu=$GPU hybrid=$HYBRID_GPU local_ai=$LOCAL_AI"
sudo -v
# Keep sudo alive while the script runs.
while true; do sudo -n true; sleep 50; kill -0 "$$" 2>/dev/null || exit; done 2>/dev/null &

# ---------------------------------------------------------------------------
# System
# ---------------------------------------------------------------------------

step "APT sources (main contrib non-free non-free-firmware, backports)"
if write_root /etc/apt/sources.list.d/debian.sources << 'EOT'
Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie trixie-updates trixie-backports
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://security.debian.org/debian-security
Suites: trixie-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOT
then note "wrote debian.sources"; fi
if [ -s /etc/apt/sources.list ]; then
    sudo mv /etc/apt/sources.list /etc/apt/sources.list.bak
    note "old sources.list moved to sources.list.bak"
fi
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get full-upgrade -y

step "Base packages"
apt_install build-essential git curl wget pkg-config libssl-dev ca-certificates \
    ripgrep fd-find fzf bat tmux jq htop xclip unzip \
    fwupd unattended-upgrades timeshift flatpak rfkill blueman power-profiles-daemon \
    alacritty fonts-jetbrains-mono libfuse2t64 \
    libreoffice libreoffice-l10n-pt-br hunspell-pt-br \
    thunderbird thunderbird-l10n-pt-br chromium chromium-l10n
[ "$ZRAM" = yes ] && apt_install zram-tools

step "Kernel and firmware ($KERNEL)"
if [ "$KERNEL" = backports ]; then
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -t trixie-backports \
        linux-image-amd64 linux-headers-amd64 firmware-linux-nonfree
else
    apt_install linux-headers-amd64 firmware-linux-nonfree
fi

# Extra packages after the kernel headers: DKMS drivers (e.g. broadcom-sta)
# build against them at install time.
# shellcheck disable=SC2086
[ -n "$EXTRA_PACKAGES" ] && apt_install $EXTRA_PACKAGES
# Packages the profile needs newer than trixie has (e.g. Mesa and firmware
# for brand-new hardware). Once installed from backports, apt upgrade keeps
# them on backports.
# shellcheck disable=SC2086
[ -n "${BACKPORTS_PACKAGES:-}" ] &&
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -t trixie-backports $BACKPORTS_PACKAGES

if [ -n "${KERNEL_PARAMS:-}" ]; then
    step "Kernel parameters ($KERNEL_PARAMS)"
    sudo install -d /etc/default/grub.d
    if write_root /etc/default/grub.d/devenv.cfg << EOT
GRUB_CMDLINE_LINUX_DEFAULT="\$GRUB_CMDLINE_LINUX_DEFAULT $KERNEL_PARAMS"
EOT
    then sudo update-grub; fi
fi

if [ "$ZRAM" = yes ]; then
    step "zram (compressed swap in RAM)"
    if write_root /etc/default/zramswap << 'EOT'
ALGO=zstd
PERCENT=50
PRIORITY=100
EOT
    then sudo systemctl restart zramswap; note "zram: 50% of RAM, zstd"; fi
fi

if [ "$GPU" != none ]; then
    step "NVIDIA driver ($GPU)"
    if [ "$GPU" = nvidia-repo ]; then
        if ! dpkg -s cuda-keyring >/dev/null 2>&1; then
            tmp="$(mktemp -d)"
            curl -fsSL -o "$tmp/cuda-keyring.deb" \
                https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb
            sudo dpkg -i "$tmp/cuda-keyring.deb"
            rm -rf "$tmp"
            sudo apt-get update
        fi
        apt_install nvidia-open
    elif [ "$KERNEL" = backports ]; then
        sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -t trixie-backports \
            nvidia-driver nvidia-kernel-dkms firmware-nvidia-graphics
    else
        apt_install nvidia-driver firmware-misc-nonfree
    fi
    # Keep video memory across suspend and hibernation. /tmp is RAM on
    # Debian 13, so the driver saves it to /var/tmp instead.
    if write_root /etc/modprobe.d/nvidia-power.conf << 'EOT'
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
EOT
    then sudo update-initramfs -u; fi
    if [ "$HYBRID_GPU" = yes ] && ! nvidia-smi >/dev/null 2>&1; then
        later "Hybrid graphics: the Intel GPU drives the desktop; run programs on the NVIDIA GPU with 'prime-run <command>'."
    fi
fi

if has mokutil && mokutil --sb-state 2>/dev/null | grep -q enabled \
    && [ -f /var/lib/dkms/mok.pub ] && ! mokutil --test-key /var/lib/dkms/mok.pub >/dev/null 2>&1; then
    step "Secure Boot: enroll the DKMS signing key"
    note "Choose a one-time password; on the next boot pick 'Enroll MOK' and type it."
    sudo mokutil --import /var/lib/dkms/mok.pub
    mok_imported=yes
fi

step "Docker"
if [ ! -f /etc/apt/sources.list.d/docker.sources ]; then
    sudo install -m 0755 -d /etc/apt/keyrings
    sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
    sudo chmod a+r /etc/apt/keyrings/docker.asc
    write_root /etc/apt/sources.list.d/docker.sources << 'EOT' || true
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: trixie
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
EOT
    sudo apt-get update
fi
apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
if ! id -nG | grep -qw docker; then
    sudo usermod -aG docker "$USER"
fi
if [ "$DOCKER_ON_DEMAND" = yes ] && systemctl is-enabled --quiet docker.service 2>/dev/null; then
    # The socket stays enabled, so the daemon starts on the first docker command.
    sudo systemctl disable --now docker.service containerd.service
    sudo systemctl enable docker.socket
    note "Docker starts on demand"
fi

if [ "$GPU" != none ] && [ "$LOCAL_AI" = yes ]; then
    step "NVIDIA Container Toolkit (GPU in containers)"
    if [ ! -f /etc/apt/sources.list.d/nvidia-container-toolkit.sources ]; then
        sudo curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
            -o /etc/apt/keyrings/nvidia-container-toolkit.asc
        write_root /etc/apt/sources.list.d/nvidia-container-toolkit.sources << 'EOT' || true
Types: deb
URIs: https://nvidia.github.io/libnvidia-container/stable/deb/amd64
Suites: /
Signed-By: /etc/apt/keyrings/nvidia-container-toolkit.asc
EOT
        sudo apt-get update
    fi
    apt_install nvidia-container-toolkit
    sudo nvidia-ctk runtime configure --runtime=docker
    sudo systemctl restart docker
fi

step "Locale (English messages, Brazilian formats) and keyboard"
# Messages in English; numbers, dates, currency, paper and units from pt_BR.
changed=no
for loc in en_US.UTF-8 pt_BR.UTF-8; do
    if ! grep -q "^$loc UTF-8" /etc/locale.gen; then
        sudo sed -i "s/^# *$loc UTF-8/$loc UTF-8/" /etc/locale.gen
        grep -q "^$loc UTF-8" /etc/locale.gen || echo "$loc UTF-8" | sudo tee -a /etc/locale.gen >/dev/null
        changed=yes
    fi
done
[ "$changed" = yes ] && sudo locale-gen
if write_root /etc/default/locale << 'EOT'
LANG=en_US.UTF-8
LC_NUMERIC=pt_BR.UTF-8
LC_TIME=pt_BR.UTF-8
LC_MONETARY=pt_BR.UTF-8
LC_PAPER=pt_BR.UTF-8
LC_MEASUREMENT=pt_BR.UTF-8
EOT
then note "locale: applies from the next login"; session_changed=yes; fi
# US international keyboard with dead keys (' then a = á, ' then c = ç;
# ' then space types a plain quote). Profiles can override.
kb_model="${KEYBOARD_MODEL:-pc105}"
kb_layout="${KEYBOARD_LAYOUT:-us}"
kb_variant="${KEYBOARD_VARIANT-intl}"   # set but empty = the layout's default
# Debian's keyboard configuration, read by X11 and the console. Written
# directly: localectl goes through D-Bus and can fail with "Access denied".
if write_root /etc/default/keyboard << EOT
XKBMODEL="$kb_model"
XKBLAYOUT="$kb_layout"
XKBVARIANT="$kb_variant"
XKBOPTIONS=""
BACKSPACE="guess"
EOT
then
    sudo udevadm trigger --subsystem-match=input --action=change
    note "keyboard: $kb_layout ${kb_variant:-(default)} on $kb_model, applies from the next login"
    session_changed=yes
fi

step "Vial keyboard access (udev)"
gid="$(id -g)"
if write_root /etc/udev/rules.d/99-vial.rules << EOT
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{serial}=="*vial:f64c2b3c*", MODE="0660", GROUP="$gid", TAG+="uaccess", TAG+="udev-acl"
EOT
then sudo udevadm control --reload && sudo udevadm trigger; fi

step "Default terminal, Bluetooth, Flatpak apps"
[ -x /usr/bin/alacritty ] && sudo update-alternatives --set x-terminal-emulator /usr/bin/alacritty
sudo rfkill unblock bluetooth || true
sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
sudo flatpak install -y --noninteractive flathub com.bitwarden.desktop

step "Brightness keys (LXQt shortcuts)"
# notify-send shows the new level on screen, like the volume keys.
apt_install libnotify-bin
# Let the video group write the backlight, so devenv-brightness can set an
# exact level (computed from the panel's max_brightness) without root.
if write_root /etc/udev/rules.d/90-backlight.rules << 'EOT'
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
EOT
then sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=backlight --action=add; fi
id -nG "$USER" | grep -qw video || sudo usermod -aG video "$USER"
# LXQt ships volume shortcuts but none for brightness. Bind the keys to
# devenv-brightness (10% steps) in the user's shortcut file, replacing
# any older brightness entries and leaving the rest alone. The file starts
# as a copy of LXQt's defaults, since an existing user file replaces them.
ks="$HOME/.config/lxqt/globalkeyshortcuts.conf"
if ! grep -qx "Exec=$repo/bin/devenv-brightness, up" "$ks" 2>/dev/null; then
    running=no
    pgrep -x -u "$USER" lxqt-globalkeysd >/dev/null && running=yes
    # Stop the daemon first: it rewrites the file from memory.
    [ "$running" = yes ] && pkill -x -u "$USER" lxqt-globalkeysd
    mkdir -p "$(dirname "$ks")"
    if [ ! -f "$ks" ]; then
        for def in /usr/share/lxqt/globalkeyshortcuts.conf /etc/xdg/lxqt/globalkeyshortcuts.conf; do
            [ -f "$def" ] && { cp "$def" "$ks"; break; }
        done
    fi
    # Drop existing [XF86MonBrightness...] sections, then append ours.
    awk '/^\[/ { skip = ($0 ~ /^\[XF86MonBrightness(Up|Down)\./) } !skip' "$ks" 2>/dev/null > "$ks.new" || true
    cat >> "$ks.new" << EOT

[XF86MonBrightnessUp.90]
Comment=Brightness up 10%
Enabled=true
Exec=$repo/bin/devenv-brightness, up

[XF86MonBrightnessDown.91]
Comment=Brightness down 10%
Enabled=true
Exec=$repo/bin/devenv-brightness, down
EOT
    mv "$ks.new" "$ks"
    if [ "$running" = yes ]; then
        # lxqt-session may restart it by itself; start it only if it didn't.
        sleep 2
        pgrep -x -u "$USER" lxqt-globalkeysd >/dev/null ||
            setsid -f lxqt-globalkeysd >/dev/null 2>&1 < /dev/null
    fi
    note "brightness keys: devenv-brightness up / down (10% per press)"
fi

# ---------------------------------------------------------------------------
# User environment
# ---------------------------------------------------------------------------

step "Toolchains: mise, uv, rustup"
[ -x "$HOME/.local/bin/mise" ] || curl -fsSL https://mise.run | sh
[ -x "$HOME/.local/bin/uv" ] || curl -LsSf https://astral.sh/uv/install.sh | sh
if [ ! -x "$HOME/.cargo/bin/rustup" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi
"$HOME/.cargo/bin/rustup" component add rust-analyzer

step "Dotfiles"
link "$repo/nvim" "$HOME/.config/nvim"
link "$repo/tmux" "$HOME/.config/tmux"
link "$repo/mise" "$HOME/.config/mise"
link "$repo/alacritty" "$HOME/.config/alacritty"
# Alacritty's per-machine file (imported by alacritty.toml): font size from
# the profile, 8 by default (sized for the 15.6" 1080p screens).
want="# Written by devenv-setup from hosts/$host.sh (TERMINAL_FONT_SIZE).
[font]
size = ${TERMINAL_FONT_SIZE:-8}"
if [ "$(cat "$HOME/.config/alacritty-host.toml" 2>/dev/null)" != "$want" ]; then
    printf '%s\n' "$want" > "$HOME/.config/alacritty-host.toml"
    note "alacritty: font size ${TERMINAL_FONT_SIZE:-8}"
fi
link "$repo/lxqt" "$HOME/.config/lxqt"
link "$repo/claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md"
link "$repo/claude/CLAUDE.md" "$HOME/.codex/AGENTS.md"
# ' + c = ç with the us-intl keyboard (applies from the next login).
[ "$(readlink "$HOME/.XCompose" 2>/dev/null)" = "$repo/x11/XCompose" ] || session_changed=yes
link "$repo/x11/XCompose" "$HOME/.XCompose"
# HiDPI screens: X11 assumes 96 DPI, so text and widgets come out tiny.
# SCREEN_DPI from the profile goes into ~/.Xresources, which the X session
# loads at login (fonts in Qt, GTK, Chromium, Firefox; Alacritty's scale).
if [ -n "${SCREEN_DPI:-}" ]; then
    xres="$HOME/.Xresources"
    if ! grep -qx "Xft.dpi: $SCREEN_DPI" "$xres" 2>/dev/null; then
        { grep -v '^Xft.dpi:' "$xres" 2>/dev/null || true; echo "Xft.dpi: $SCREEN_DPI"; } > "$xres.new"
        mv "$xres.new" "$xres"
        [ -n "${DISPLAY:-}" ] && xrdb -merge "$xres"
        note "screen: Xft.dpi $SCREEN_DPI in ~/.Xresources (reopen apps to see it)"
    fi
fi
line="[ -f \"$repo/bash/bashrc\" ] && . \"$repo/bash/bashrc\""
grep -qF "$repo/bash/bashrc" "$HOME/.bashrc" 2>/dev/null || {
    printf '\n%s\n' "$line" >> "$HOME/.bashrc"
    note "added the bash snippet to ~/.bashrc"
}

step "Tools pinned in mise/config.toml"
# Node first: the npm: tools (Codex, Bitwarden CLI) need it.
"$HOME/.local/bin/mise" install node
"$HOME/.local/bin/mise" install

step "Git"
# The LXQt session runs an ssh-agent; this asks for the key passphrase once
# per login instead of on every push and signed commit.
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
if ! grep -qi '^AddKeysToAgent' "$HOME/.ssh/config" 2>/dev/null; then
    { echo "AddKeysToAgent yes"; cat "$HOME/.ssh/config" 2>/dev/null || true; } > "$HOME/.ssh/config.new"
    mv "$HOME/.ssh/config.new" "$HOME/.ssh/config"
    chmod 600 "$HOME/.ssh/config"
    note "ssh: AddKeysToAgent yes in ~/.ssh/config"
fi
if [ -z "$(git config --global user.name || true)" ]; then
    read -rp "    git user.name: " name
    git config --global user.name "$name"
fi
if [ -z "$(git config --global user.email || true)" ]; then
    read -rp "    git user.email: " email
    git config --global user.email "$email"
fi
git config --global init.defaultBranch main
git config --global gpg.format ssh
git config --global user.signingkey "$HOME/.ssh/id_ed25519.pub"
git config --global commit.gpgsign true
git config --global core.pager delta
git config --global interactive.diffFilter "delta --color-only"
git config --global delta.navigate true
git config --global merge.conflictStyle zdiff3

step "Coding agents"
has claude || [ -x "$HOME/.local/bin/claude" ] || curl -fsSL https://claude.ai/install.sh | bash
[ -x "$HOME/.opencode/bin/opencode" ] || curl -fsSL https://opencode.ai/install | bash

if [ "$LOCAL_AI" = yes ]; then
    step "Local AI (ollama, llama.cpp completion server, llm)"
    "$HOME/.local/bin/uv" tool install llm --with llm-ollama
fi
if [ "$LOCAL_AI" = yes ] && [ "$GPU" != none ] && ! nvidia-smi >/dev/null 2>&1; then
    later "After rebooting into the NVIDIA driver, run devenv-setup again to create the ollama and llama-fim containers."
elif [ "$LOCAL_AI" = yes ] && [ "$GPU" != none ]; then
    if ! sudo docker container inspect ollama >/dev/null 2>&1; then
        sudo docker run -d --gpus all --name ollama --restart unless-stopped \
            -v ollama:/root/.ollama -p 11434:11434 ollama/ollama
    fi
    if ! sudo docker container inspect llama-fim >/dev/null 2>&1; then
        sudo docker run -d --gpus all --name llama-fim --restart unless-stopped \
            -p 127.0.0.1:8012:8012 -v llama-cache:/root/.cache \
            ghcr.io/ggml-org/llama.cpp:server-cuda \
            --fim-qwen-1.5b-default --host 0.0.0.0
    fi
    if [ -z "$(sudo docker exec ollama ollama list 2>/dev/null | tail -n +2)" ]; then
        later "Pull a chat model: docker exec -it ollama ollama pull qwen2.5-coder:7b; then: llm models default qwen2.5-coder:7b"
    fi
fi

# ---------------------------------------------------------------------------
# Snapshots, keys and logins
# ---------------------------------------------------------------------------

step "System snapshots (Timeshift)"
# The whole config is managed here, like the dotfiles: rsync, daily (keep 5)
# and weekly (keep 2), /home and /root excluded. Snapshots go to the system
# partition, or to the partition labelled $TIMESHIFT_LABEL when the profile
# sets one (a second disk survives the system disk dying).
# Changes made in the GUI to these settings are reset on the next run.
# Timeshift itself writes or removes /etc/cron.d/timeshift-hourly from these
# settings every time it runs, so the cron job isn't written here.
apt_install cron
ts_uuid="$(findmnt -no UUID /)"
if [ -n "${TIMESHIFT_LABEL:-}" ]; then
    label_uuid="$(lsblk -nro UUID,LABEL | awk -v l="$TIMESHIFT_LABEL" '$2 == l { print $1; exit }')"
    if [ -n "$label_uuid" ]; then
        ts_uuid="$label_uuid"
    else
        later "Second disk for snapshots: find it with 'lsblk -o NAME,SIZE,MODEL,FSTYPE,LABEL', then format it (ERASES it): sudo mkfs.ext4 -L $TIMESHIFT_LABEL /dev/<disk>; then run devenv-setup again. Until then snapshots go to the system disk."
    fi
fi
ts=/etc/timeshift/timeshift.json
# Applied on top of the current file (or default.json the first time) and
# compared as JSON, because Timeshift rewrites the file in its own format
# and adds keys of its own; only a real settings change is written.
src="$ts"; sudo test -f "$ts" || src=/etc/timeshift/default.json
new_ts="$(sudo jq -S --arg uuid "$ts_uuid" '
    .backup_device_uuid = $uuid | .parent_device_uuid = "" |
    .do_first_run = "false" | .btrfs_mode = "false" | .stop_cron_emails = "true" |
    .schedule_monthly = "false" | .schedule_weekly = "true" | .schedule_daily = "true" |
    .schedule_hourly = "false" | .schedule_boot = "false" |
    .count_weekly = "2" | .count_daily = "5" |
    .exclude = ["/home/**", "/root/**"]' "$src")"
if [ "$new_ts" != "$(sudo jq -S . "$ts" 2>/dev/null)" ]; then
    printf '%s\n' "$new_ts" | sudo tee "$ts" >/dev/null
    note "configured: rsync on $ts_uuid, daily 5, weekly 2, /home excluded"
fi
# Snapshots live in timeshift/snapshots at the root of the target partition.
# Checked on disk: parsing 'timeshift --list' missed it on the MBA.
if [ "$ts_uuid" = "$(findmnt -no UUID /)" ]; then
    snaps="$(sudo find /timeshift/snapshots -mindepth 1 -maxdepth 1 2>/dev/null || true)"
else
    mnt="$(mktemp -d)"
    sudo mount -o ro "UUID=$ts_uuid" "$mnt"
    snaps="$(sudo find "$mnt/timeshift/snapshots" -mindepth 1 -maxdepth 1 2>/dev/null || true)"
    sudo umount "$mnt" && rmdir "$mnt"
fi
if [ -z "$snaps" ]; then
    note "first snapshot (a few minutes)"
    sudo timeshift --create --scripted --comments "devenv-setup: first snapshot"
fi

step "SSH keys and GitHub"
mise_exec() { "$HOME/.local/bin/mise" exec -- "$@"; }
ask() { local a; read -rp "    $1 [Y/n] " a; [[ -z "$a" || "$a" =~ ^[Yy] ]]; }
if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
    if ask "Restore this machine's SSH keys from Bitwarden now?"; then
        mise_exec "$repo/bin/devenv-keys" || note "devenv-keys failed; run it again later"
    fi
fi
origin="$(git -C "$repo" remote get-url origin)"
if [ -f "$HOME/.ssh/id_ed25519" ] && [[ "$origin" == https://github.com/* ]]; then
    git -C "$repo" remote set-url origin git@github.com:lucattelli/the-2026-dev-env.git
    note "repo remote switched to SSH"
fi
if ! mise_exec gh auth status >/dev/null 2>&1; then
    if ask "Log in to the GitHub CLI now (opens the browser)?"; then
        mise_exec gh auth login --hostname github.com --git-protocol ssh --skip-ssh-key --web ||
            note "gh login failed; run 'gh auth login' later"
    fi
fi

# ---------------------------------------------------------------------------
# What's left: only what is still pending on this machine, so a re-run on a
# finished machine prints nothing to do.
# ---------------------------------------------------------------------------

reasons=()
newest="$(find /boot -maxdepth 1 -name 'vmlinuz-*' -printf '%f\n' | sed 's/^vmlinuz-//' | sort -V | tail -1)"
[ -n "$newest" ] && [ "$(uname -r)" != "$newest" ] && reasons+=("kernel $newest")
for p in ${KERNEL_PARAMS:-}; do
    grep -qw -- "$p" /proc/cmdline || { reasons+=("kernel parameters"); break; }
done
case " $EXTRA_PACKAGES " in *" broadcom-sta-dkms "*)
    grep -q '^wl ' /proc/modules || reasons+=("Wi-Fi driver") ;;
esac
[ "$GPU" != none ] && ! nvidia-smi >/dev/null 2>&1 && reasons+=("NVIDIA driver")
for g in sudo docker video; do
    if id -nG "$USER" | grep -qw "$g" && ! id -nG | grep -qw "$g"; then
        reasons+=("$g group"); break
    fi
done
[ "${session_changed:-}" = yes ] && reasons+=("locale and keyboard")
[ "${mok_imported:-}" = yes ] && reasons+=("Secure Boot key: on the blue MOK screen pick Enroll MOK -> Continue -> type the password")

pending=()
if [ "${#reasons[@]}" -gt 0 ]; then
    pending+=("Reboot ($(IFS=,; echo "${reasons[*]}" | sed 's/,/, /g')).")
fi
case " $EXTRA_PACKAGES " in *" broadcom-sta-dkms "*)
    nmcli -t -f TYPE,STATE device 2>/dev/null | grep -q '^wifi:connected' ||
        pending+=("Connect to Wi-Fi: nmcli device wifi connect '<network>' --ask (this card is WPA2 only).") ;;
esac
pending+=("${todo[@]}")
[ -f "$HOME/.ssh/id_ed25519" ] ||
    pending+=("Restore SSH keys: devenv-keys (logs in to Bitwarden), then run devenv-setup again.")
mise_exec gh auth status >/dev/null 2>&1 || pending+=("Log in to the GitHub CLI: gh auth login")
[ -f "$HOME/.claude/.credentials.json" ] || pending+=("Log in to Claude Code: claude")
[ -f "$HOME/.codex/auth.json" ] || pending+=("Log in to Codex: codex")
[ -n "$(find "$HOME/.local/share/nvim/site/pack" -mindepth 3 -maxdepth 3 2>/dev/null)" ] ||
    pending+=("Open nvim once to install plugins and language servers.")

if [ "${#pending[@]}" -eq 0 ]; then
    step "Done. Nothing left to do by hand."
    note "devenv-check shows the full state."
else
    step "Done. Still to do by hand:"
    pending+=("Check everything: devenv-check (in a new terminal).")
    i=1
    for t in "${pending[@]}"; do
        printf '  %d. %s\n' "$i" "$t"
        i=$((i + 1))
    done
fi
